ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:18793
HOMELENS_IMAGE=homelens:0.2.5-arm64
HOST_PORT=18793
# Optional first-run router seed. Afterwards manage routers in /admin.
ROUTER_BRAND=zte
ROUTER_ADDRESS=
ROUTER_USERNAME=admin
ROUTER_PASSWORD=

# Optional Ookla CLI, personal use; build with --build-arg INSTALL_SPEEDTEST=true.
SPEEDTEST_ENABLED=false
SPEEDTEST_TIMEZONE=Asia/Shanghai
